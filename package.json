{
  "name": "super-mario",
  "version": "1.0.0",
  "type": "module",
  "description": "",
  "main": "index.js",
  "scripts": {
    "start": "concurrently --kill-others \"npm:server\" \"npm:game\"",
    "dev": "concurrently --kill-others \"npm:server:watch\" \"npm:game\"",
    "game": "vite --host 127.0.0.1",
    "server": "tsx server/index.ts",
    "server:watch": "tsx watch server/index.ts",
    "build": "npm run prisma:generate && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "npm run prisma:generate && tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test": "npm run prisma:generate && node --import tsx --test server/routes/performance.test.ts",
    "performance:latest": "tsx server/scripts/latest-performance-samples.ts",
    "prisma:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "dotenv": "^17.4.2",
    "express": "^4.22.2",
    "pg": "^8.23.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/node": "^22.20.1",
    "@types/pg": "^8.21.0",
    "concurrently": "^9.2.4",
    "prisma": "^7.9.1",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vite": "^8.2.0"
  }
}
