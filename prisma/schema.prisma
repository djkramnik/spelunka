generator client {
  provider = "prisma-client"
  output   = "../server/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// One measured run of the game. Its samples share browser and source context.
model PerformanceSession {
  id            String              @id
  sourceUrl     String
  userAgent     String
  startedAt     DateTime
  lastSeenAt    DateTime
  benchmarkName String?             @map("benchmark_name")
  gitCommit     String?             @map("git_commit")
  createdAt     DateTime            @default(now())
  samples       PerformanceSample[]

  @@index([benchmarkName, gitCommit], map: "performance_session_benchmark_name_git_commit_idx")
  @@map("performance_session")
}

/// One five-second performance window collected during a measured game run.
model PerformanceSample {
  id          Int                @id @default(autoincrement())
  sessionId   String
  sequence    Int
  capturedAt  DateTime
  durationMs  Float
  payload     Json
  createdAt   DateTime           @default(now())
  session     PerformanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, sequence])
  @@index([capturedAt])
  @@map("performance_sample")
}
